nextflow_process {

    name "Test Process VCF_EXPRESSION_ANNOTATOR"
    script "modules/vcf_expression_annotator.nf"
    process "VCF_EXPRESSION_ANNOTATOR"

    test("Should run without failures") {

        when {
            process {
                """
                input[0] = file("${projectDir}/tests/data/samplesheet.csv")
                input[1] = '/projects/academic/prinicipal_investigator/research_project'
                """
            }
        }

        then {
            assert process.success
            assert snapshot(process.out).match()
        }

    }

}
