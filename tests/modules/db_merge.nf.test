nextflow_process {

    name "Test Process DB_MERGE"
    script "modules/db_merge.nf"
    process "DB_MERGE"

    test("Should run without failures") {

        when {
            process {
                """
                input[0] = file("${projectDir}/tests/data/samplesheet.csv")
                input[1] = '/projects/academic/prinicipal_investigator/research_project'
                """
            }
        }

        then {
            assert process.success
            assert snapshot(process.out).match()
        }

    }

}
